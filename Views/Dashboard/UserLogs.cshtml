@model LDMS_Final.ViewModels.UserLogsViewModel
@using LDMS_Final.Models
@using System.Collections.Specialized
@{
    ViewData["Title"] = "User Logs";
    Layout = "_Layout";

    // Build query string helper for pagination that keeps current filters
    string PageUrl(int p)
    {
        var qs = new System.Collections.Specialized.NameValueCollection
        {
            ["page"]         = p.ToString(),
            ["searchName"]   = Model.SearchName   ?? "",
            ["searchUserId"] = Model.SearchUserId ?? "",
            ["filterRole"]   = Model.FilterRole   ?? "",
            ["filterAction"] = Model.FilterAction ?? "",
            ["dateFrom"]     = Model.DateFrom     ?? "",
            ["dateTo"]       = Model.DateTo       ?? ""
        };
        var parts = new List<string>();
        foreach (string? key in qs.AllKeys) if (!string.IsNullOrEmpty(qs[key]))
            parts.Add($"{key}={Uri.EscapeDataString(qs[key]!)}");
        return "?" + string.Join("&", parts);
    }
}

<style>
    .log-table th { font-size: .78rem; font-weight: 600; white-space: nowrap; }
    .log-table td { font-size: .82rem; vertical-align: middle; }
    .filter-chip { display:inline-flex; align-items:center; gap:6px; background:#e8f0fe;
                   color:#1a56db; border-radius:20px; padding:3px 10px; font-size:.75rem;
                   font-weight:500; }
    .filter-chip .remove { cursor:pointer; font-weight:700; opacity:.7; }
    .filter-chip .remove:hover { opacity:1; }
    .role-pill { font-size:.7rem; padding:2px 8px; }
    .action-pill { font-size:.7rem; padding:2px 8px; }
    .log-row:hover { background:#f8faff; cursor:pointer; }
    .id-cell { font-family: monospace; font-size:.72rem; color:#6c757d;
               max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
</style>

<div class="container-fluid py-4 px-4">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="text-dark fw-bold mb-0">User Activity Logs</h1>
            <p class="text-dark mb-0 mt-1">
                @Model.TotalCount.ToString("N0") records found
                @if (Model.TotalCount > 0)
                { <text>· Page @Model.PageNumber of @Model.TotalPages</text> }
            </p>
        </div>
        <a asp-action="ExportLogs"
           asp-route-searchName="@Model.SearchName"
           asp-route-searchUserId="@Model.SearchUserId"
           asp-route-filterRole="@Model.FilterRole"
           asp-route-filterAction="@Model.FilterAction"
           asp-route-dateFrom="@Model.DateFrom"
           asp-route-dateTo="@Model.DateTo"
           class="btn btn-outline-dark rounded-pill px-4">
            <i class="bi bi-download me-2"></i>Export CSV
        </a>
    </div>

    <!-- ── Filter panel ─────────────────────────────────────────────────── -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body px-4 py-3">
            <form method="get" asp-action="UserLogs" id="filterForm">
                <input type="hidden" name="page" value="1" />

                <div class="row g-3 align-items-end">

                    <!-- Search name -->
                    <div class="col-12 col-md-4 col-lg-3">
                        <label class="form-label form-label-sm fw-semibold mb-1">
                            <i class="bi bi-search me-1 text-dark"></i>Search Name
                        </label>
                        <input type="text" name="searchName" class="form-control form-control-sm rounded-3"
                               placeholder="Full name or username…"
                               value="@Model.SearchName" />
                    </div>

                    <!-- Search user ID -->
                    <div class="col-12 col-md-4 col-lg-3">
                        <label class="form-label form-label-sm fw-semibold mb-1">
                            <i class="bi bi-fingerprint me-1 text-dark"></i>User ID
                        </label>
                        <input type="text" name="searchUserId" class="form-control form-control-sm rounded-3"
                               placeholder="Partial or full User ID…"
                               value="@Model.SearchUserId" />
                    </div>

                    <!-- Role filter -->
                    <div class="col-6 col-md-2 col-lg-2">
                        <label class="form-label form-label-sm fw-semibold mb-1">
                            <i class="bi bi-person-badge me-1 text-dark"></i>Role
                        </label>
                        <select name="filterRole" class="form-select form-select-sm rounded-3">
                            <option value="">All Roles</option>
                            @foreach (var r in Model.AllRoles)
                            {
                                @if (Model.FilterRole == r)
                                {
                                    <option value="@r" selected>@r</option>
                                }
                                else
                                {
                                    <option value="@r">@r</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Action filter -->
                    <div class="col-6 col-md-2 col-lg-2">
                        <label class="form-label form-label-sm fw-semibold mb-1">
                            <i class="bi bi-lightning me-1 text-dark"></i>Action
                        </label>
                        <select name="filterAction" class="form-select form-select-sm rounded-3">
                            <option value="">All Actions</option>
                            @foreach (var a in Model.AllActions)
                            {
                                @if (Model.FilterAction == a)
                                {
                                    <option value="@a" selected>@a</option>
                                }
                                else
                                {
                                    <option value="@a">@a</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Date range -->
                    <div class="col-6 col-md-2 col-lg-1">
                        <label class="form-label form-label-sm fw-semibold mb-1">From</label>
                        <input type="date" name="dateFrom" class="form-control form-control-sm rounded-3"
                               value="@Model.DateFrom" />
                    </div>
                    <div class="col-6 col-md-2 col-lg-1">
                        <label class="form-label form-label-sm fw-semibold mb-1">To</label>
                        <input type="date" name="dateTo" class="form-control form-control-sm rounded-3"
                               value="@Model.DateTo" />
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 col-lg-auto d-flex gap-2">
                        <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">
                            <i class="bi bi-funnel me-1"></i>Apply
                        </button>
                        <a asp-action="UserLogs" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            Clear
                        </a>
                    </div>
                </div>
            </form>

            <!-- Active filter chips -->
            @{
                bool hasFilters = !string.IsNullOrEmpty(Model.SearchName)
                               || !string.IsNullOrEmpty(Model.SearchUserId)
                               || !string.IsNullOrEmpty(Model.FilterRole)
                               || !string.IsNullOrEmpty(Model.FilterAction)
                               || !string.IsNullOrEmpty(Model.DateFrom)
                               || !string.IsNullOrEmpty(Model.DateTo);
            }
            @if (hasFilters)
            {
                <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                    <small class="text-dark me-1">Active filters:</small>
                    @if (!string.IsNullOrEmpty(Model.SearchName))
                    {
                        <span class="filter-chip">Name: @Model.SearchName
                            <a href="@PageUrl(1).Replace($"searchName={Uri.EscapeDataString(Model.SearchName)}&", "").Replace($"searchName={Uri.EscapeDataString(Model.SearchName)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.SearchUserId))
                    {
                        <span class="filter-chip">User ID: @Model.SearchUserId
                            <a href="@PageUrl(1).Replace($"searchUserId={Uri.EscapeDataString(Model.SearchUserId)}&", "").Replace($"searchUserId={Uri.EscapeDataString(Model.SearchUserId)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.FilterRole))
                    {
                        <span class="filter-chip">Role: @Model.FilterRole
                            <a href="@PageUrl(1).Replace($"filterRole={Uri.EscapeDataString(Model.FilterRole)}&", "").Replace($"filterRole={Uri.EscapeDataString(Model.FilterRole)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.FilterAction))
                    {
                        <span class="filter-chip">Action: @Model.FilterAction
                            <a href="@PageUrl(1).Replace($"filterAction={Uri.EscapeDataString(Model.FilterAction)}&", "").Replace($"filterAction={Uri.EscapeDataString(Model.FilterAction)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.DateFrom))
                    {
                        <span class="filter-chip">From: @Model.DateFrom
                            <a href="@PageUrl(1).Replace($"dateFrom={Uri.EscapeDataString(Model.DateFrom)}&", "").Replace($"dateFrom={Uri.EscapeDataString(Model.DateFrom)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.DateTo))
                    {
                        <span class="filter-chip">To: @Model.DateTo
                            <a href="@PageUrl(1).Replace($"dateTo={Uri.EscapeDataString(Model.DateTo)}&", "").Replace($"dateTo={Uri.EscapeDataString(Model.DateTo)}", "")"
                               class="remove text-decoration-none">×</a>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ── Log table ────────────────────────────────────────────────────── -->
    @if (!Model.Logs.Any())
    {
        <div class="text-center py-5 text-dark">
            <i class="bi bi-journal-x display-4 d-block mb-3"></i>
            No activity logs match the current filters.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="table-responsive">
                <table class="table log-table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:40px;">#</th>
                            <th>User</th>
                            <th>User ID</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Date &amp; Time</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr class="log-row" data-id="@log.Id"
                                onclick="showLogDetail(@log.Id)">
                                <td class="text-dark">@log.Id</td>
                                <td>
                                    <div class="fw-semibold">@(log.FullName ?? "Unknown User")</div>
                                    <div class="text-dark" style="font-size:.72rem;">@@log.UserName</div>
                                </td>
                                <td>
                                    <span class="id-cell d-inline-block" title="@log.UserId">
                                        @log.UserId
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill role-pill @RoleBadge(log.Role)">
                                        @log.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill action-pill @ActionBadge(log.Action)">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="text-dark" style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @(log.Description ?? "—")
                                    @if (!string.IsNullOrEmpty(log.EntityType))
                                    {
                                        <span class="badge bg-light text-dark border ms-1" style="font-size:.65rem;">
                                            @log.EntityType
                                            @if (!string.IsNullOrEmpty(log.EntityId)) { <text>· @log.EntityId</text> }
                                        </span>
                                    }
                                </td>
                                <td class="text-dark text-nowrap">
                                    <div>@log.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                    <div style="font-size:.72rem;">@log.CreatedAt.ToLocalTime().ToString("h:mm:ss tt")</div>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-light rounded-circle p-1"
                                            onclick="event.stopPropagation();showLogDetail(@log.Id)"
                                            title="View detail">
                                        <i class="bi bi-eye" style="font-size:.8rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Pagination ── -->
        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm justify-content-center gap-1 flex-wrap">
                    <!-- First / Prev -->
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light" href="@PageUrl(1)">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light" href="@PageUrl(Model.PageNumber - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }

                    @{
                        int startPage = Math.Max(1, Model.PageNumber - 2);
                        int endPage   = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                    }
                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link rounded-3 border-0 @(p == Model.PageNumber ? "bg-dark text-white" : "bg-light")"
                               href="@PageUrl(p)">@p</a>
                        </li>
                    }

                    <!-- Next / Last -->
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light" href="@PageUrl(Model.PageNumber + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link rounded-3 border-0 bg-light" href="@PageUrl(Model.TotalPages)">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    }
                </ul>
                <p class="text-center text-dark small mt-2">
                    Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount.ToString("N0") records
                </p>
            </nav>
        }
    }
</div>

<!-- ── Detail Modal ─────────────────────────────────────────────────────── -->
<div class="modal fade" id="logDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-journal-text me-2 text-primary"></i>Log Detail</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3" id="logDetailBody">
                <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
            </div>
        </div>
    </div>
</div>

@functions {
    string RoleBadge(string role) => role switch
    {
        "Admin"          => "bg-primary",
        "SuperAdmin"     => "bg-danger",
        "LogisticStaff"  => "bg-info text-dark",
        "WarehouseStaff" => "bg-warning text-dark",
        "Driver"         => "bg-secondary",
        "Buyer"          => "bg-success",
        _                => "bg-light text-dark border"
    };

    string ActionBadge(string action) => action switch
    {
        //UserAction.Login         => "bg-success-subtle text-success border border-success-subtle",
        //UserAction.Logout        => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        //UserAction.LoginFailed   => "bg-danger-subtle text-danger border border-danger-subtle",
        UserAction.OrderApproved => "bg-primary-subtle text-primary border border-primary-subtle",
        UserAction.OrderPlaced   => "bg-info-subtle text-info border border-info-subtle",
        UserAction.OrderCancelled=> "bg-danger-subtle text-danger border border-danger-subtle",
        UserAction.RouteAssigned => "bg-primary-subtle text-primary border border-primary-subtle",
        UserAction.AccountCreated => "bg-success-subtle text-success border border-success-subtle",
        UserAction.AccountDeleted=> "bg-danger-subtle text-danger border border-danger-subtle",
        _                        => "bg-light text-dark border"
    };
}

@section Scripts {
<script>
    async function showLogDetail(id) {
        const modal = new bootstrap.Modal(document.getElementById('logDetailModal'));
        const body  = document.getElementById('logDetailBody');
        body.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>';
        modal.show();

        try {
            const res  = await fetch(`/Dashboard/LogDetail/${id}`);
            const log  = await res.json();
            const date = new Date(log.createdAt).toLocaleString('en-PH', {
                month: 'short', day: 'numeric', year: 'numeric',
                hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true
            });

            body.innerHTML = `
                <div class="row g-3">
                    <div class="col-6">
                        <small class="text-dark d-block">Full Name</small>
                        <span class="fw-semibold">${log.fullName}</span>
                    </div>
                    <div class="col-6">
                        <small class="text-dark d-block">Username</small>
                        <span>@@${log.userName}</span>
                    </div>
                    <div class="col-12">
                        <small class="text-dark d-block">User ID</small>
                        <code class="small user-select-all">${log.userId}</code>
                    </div>
                    <div class="col-6">
                        <small class="text-dark d-block">Role</small>
                        <span class="badge bg-primary rounded-pill">${log.role}</span>
                    </div>
                    <div class="col-6">
                        <small class="text-dark d-block">Action</small>
                        <span class="badge bg-dark rounded-pill">${log.action}</span>
                    </div>
                    ${log.description ? `
                    <div class="col-12">
                        <small class="text-dark d-block">Description</small>
                        <span>${log.description}</span>
                    </div>` : ''}
                    ${log.entityType ? `
                    <div class="col-6">
                        <small class="text-dark d-block">Entity Type</small>
                        <span>${log.entityType}</span>
                    </div>
                    <div class="col-6">
                        <small class="text-dark d-block">Entity ID</small>
                        <span class="fw-semibold">${log.entityId ?? '—'}</span>
                    </div>` : ''}
                    <div class="col-6">
                        <small class="text-dark d-block">IP Address</small>
                        <span>${log.ipAddress ?? '—'}</span>
                    </div>
                    <div class="col-6">
                        <small class="text-dark d-block">Date &amp; Time</small>
                        <span>${date}</span>
                    </div>
                </div>`;
        } catch {
            body.innerHTML = '<p class="text-danger mb-0">Failed to load log details.</p>';
        }
    }

    // Live search on name/id fields with 400ms debounce
    ['searchName', 'searchUserId'].forEach(name => {
        const input = document.querySelector(`[name="${name}"]`);
        if (!input) return;
        let timer;
        input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => document.getElementById('filterForm').submit(), 400);
        });
    });
</script>
}