@model LDMS_Final.ViewModels.BuyerHomeViewModel
@{
    ViewData["Title"] = "Shop";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4" style="background:#fff; min-height:100vh;">

    <!-- Search + Filter Bar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-grow-1 flex-wrap">
            <input type="text" name="search" value="@Model.SearchQuery" class="form-control" style="max-width:320px;"
                   placeholder="Search products, brands..." />
            <select name="category" class="form-select" style="max-width:200px;" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                }
            </select>
            <button type="submit" class="btn btn-dark px-4">
                <i class="bi bi-search me-1"></i> Search
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="text-center py-5 text-dark">
            <i class="bi bi-bag-x display-4 d-block mb-3 opacity-50"></i>
            <p class="mb-0">No products found.</p>
        </div>
    }
    else
    {
        @* Group by category *@
        var grouped = Model.Products.GroupBy(p => p.Category).OrderBy(g => g.Key);

        @foreach (var group in grouped)
        {
            <div class="mb-5">
                <!-- Category Header -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="fw-bold mb-0" style="color:#111;">
                        @group.Key
                        <span class="fw-normal small opacity-75">(@group.Count())</span>
                    </h4>
                </div>

                <!-- Product Grid -->
                <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
                    @foreach (var product in group)
                    {
                        <div class="col">
                            <div class="product-card"
                                 onclick="window.location='@Url.Action("ProductDetail", new { id = product.Id })'">
                                <div class="product-card-img">
                                    @if (!string.IsNullOrEmpty(product.ImagePath1))
                                    {
                                        <img src="@product.ImagePath1" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center"
                                             style="background:#f5f5f5;aspect-ratio:3/4;">
                                            <i class="bi bi-image text-dark fs-1"></i>
                                        </div>
                                    }

                                    @* Stock badge *@
                                    @if (product.StockStatus == "OutOfStock")
                                    {
                                        <span class="stock-badge-outofstock">Out of Stock</span>
                                    }
                                    else if (product.StockStatus == "LowStock")
                                    {
                                        <span class="stock-badge-lowstock">Low Stock</span>
                                    }

                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        @* Favorite button *@
                                        <form asp-action="ToggleFavorite" method="post" class="d-inline"
                                                onclick="event.stopPropagation()">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="returnUrl"
                                                    value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="product-card-fav">
                                                <i class="bi @(product.IsFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>

                                <div class="product-card-body">
                                    <div class="product-card-brand">@product.Brand</div>
                                    <div class="product-card-name">@product.Name</div>
                                    <div class="product-card-price">₱@product.Price.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>