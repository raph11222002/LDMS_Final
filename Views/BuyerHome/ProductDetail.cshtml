@model LDMS_Final.ViewModels.BuyerProductDetailViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
    var images = new[] { Model.ImagePath1, Model.ImagePath2, Model.ImagePath3, Model.ImagePath4, Model.ImagePath5 }
        .Where(x => !string.IsNullOrEmpty(x)).ToList();

    var sizes = string.IsNullOrEmpty(Model.Sizes)
        ? new List<string>()
        : Model.Sizes.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();

    string Normalize(string? value) => (value ?? "").Trim().ToLowerInvariant();
    string StockKey(string? variant, string? size) => $"{Normalize(variant)}|{Normalize(size)}";

    var stockMap = Model.Stocks.ToDictionary(
        x => StockKey(x.VariantName, x.SelectedSize),
        x => x.Stock);

    int GetStock(string? variant, string? size)
        => stockMap.TryGetValue(StockKey(variant, size), out var qty) ? qty : 0;

    var hasVariants = Model.Variants.Any();
    var hasSizes = sizes.Any();
    var canBuy = Model.TotalStock > 0;
}

<div class="container-fluid py-4 px-4" style="background:#fff; min-height:100vh;">

    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-arrow-left me-1"></i> Back to Shop
        </a>
    </div>

    <div class="row g-4">

        <!-- Left: Image Gallery -->
        <div class="col-12 col-md-7 col-lg-7">
            <div class="d-flex gap-3">

                <!-- Thumbnail strip -->
                @if (images.Count > 1)
                {
                    <div class="thumb-strip d-none d-md-flex">
                        @for (int i = 0; i < images.Count; i++)
                        {
                            <button type="button" class="@(i == 0 ? "active" : "")"
                                    onclick="switchMainImage('@images[i]', this)">
                                <img src="@images[i]" alt="Thumbnail @(i + 1)" />
                            </button>
                        }
                    </div>
                }

                <!-- Main image -->
                <div class="flex-grow-1">
                    <div style="border-radius:12px;overflow:hidden;background:#f5f5f5;">
                        @if (images.Any())
                        {
                            <img id="mainImage" src="@images[0]" alt="@Model.Name"
                                 style="width:100%;aspect-ratio:3/4;object-fit:cover;display:block;" />
                        }
                        else
                        {
                            <div
                                style="width:100%;aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;">
                                <i class="bi bi-image text-dark" style="font-size:3rem;"></i>
                            </div>
                        }
                    </div>

                    <!-- Mobile thumbnail strip -->
                    @if (images.Count > 1)
                    {
                        <div class="d-flex d-md-none gap-2 mt-2 flex-wrap">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                <button type="button" class="thumb-strip @(i == 0 ? "active" : "")"
                                        onclick="switchMainImage('@images[i]', this)"
                                        style="border:2px solid @(i == 0 ? "#111" : "#ddd");border-radius:6px;padding:2px;background:none;cursor:pointer;">
                                    <img src="@images[i]"
                                         style="width:52px;height:60px;object-fit:cover;border-radius:4px;display:block;" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Product Info -->
        <div class="col-12 col-md-5 col-lg-5">

            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-dark mb-1">@Model.Brand</div>
                    <h2 class="fw-bold mb-1" style="color:#111;">@Model.Name</h2>
                    <div class="text-dark mb-2">@Model.Category</div>
                    <div class="fs-4 fw-bold mb-3" style="color:#111;">₱@Model.Price.ToString("N2")</div>
                </div>
            </div>

            <!-- Stock Status -->
            @if (Model.StockStatus == "OutOfStock")
            {
                <div class="alert alert-danger py-2 rounded-3 mb-3">
                    <i class="bi bi-x-circle me-2"></i>Out of Stock — currently unavailable for purchase.
                </div>
            }
            else if (Model.StockStatus == "LowStock")
            {
                <div class="alert alert-warning py-2 rounded-3 mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>Low Stock — only @Model.TotalStock left!
                </div>
            }

            <!-- Variants -->
            @if (hasVariants)
            {
                <div class="mb-3">
                    <div class="fw-semibold mb-2" style="font-size:0.9rem;">Select Variant</div>
                    <div class="d-flex flex-wrap gap-2" id="variantButtons">
                        @foreach (var v in Model.Variants)
                        {
                            var variantQty = hasSizes
                                ? Model.Stocks
                                    .Where(s => string.Equals(Normalize(s.VariantName), Normalize(v.Name),
                                            StringComparison.OrdinalIgnoreCase))
                                    .Sum(s => s.Stock)
                                : GetStock(v.Name, null);

                            var isVariantOutOfStock = variantQty <= 0;

                            <button type="button" class="variant-btn @(isVariantOutOfStock ? "variant-out-of-stock" : "")"
                                    data-variant="@v.Name" data-stock="@variantQty" onclick="selectVariant(this)"
                                @(isVariantOutOfStock ? "disabled=\"disabled\"" : null)
                                    title="@v.Name @(isVariantOutOfStock ? "(Out of Stock)" : $"({variantQty} left)")">
                                @if (!string.IsNullOrEmpty(v.ImagePath))
                                {
                                    <img src="@v.ImagePath" alt="@v.Name" />
                                }
                                else
                                {
                                    <span style="display:inline-block;padding:6px 14px;font-size:0.85rem;font-weight:500;">
                                        @v.Name
                                    </span>
                                }
                            </button>
                        }
                    </div>
                    <!-- Variant warning — shown below the buttons -->
                    <div id="variantName" class="text-dark small mt-1"></div>
                    <div id="variantWarning" class="text-danger small mt-1" style="display:none;">
                        <i class="bi bi-exclamation-circle me-1"></i>Please select a variant.
                    </div>
                </div>
            }

            <!-- Sizes -->
            @if (hasSizes)
            {
                <div class="mb-4">
                    <div class="fw-semibold mb-2" style="font-size:0.9rem;">Select Size</div>
                    <div class="d-flex flex-wrap gap-2" id="sizeButtons">
                        @foreach (var size in sizes)
                        {
                            var sizeQty = hasVariants ? 0 : GetStock(null, size);
                            var isOutOfStock = !hasVariants && sizeQty <= 0;

                            <button type="button"
                                    class="size-btn @(isOutOfStock ? "opacity-75 stock-empty" : "")"
                                    data-size="@size"
                                    data-stock="@sizeQty"
                                    onclick="selectSize(this)"
                                    @(hasVariants || isOutOfStock ? "disabled=\"disabled\"" : null)
                                    title="@size @(hasVariants ? "(Select a variant first)" : (isOutOfStock ? "(Out of Stock)" : $"({sizeQty} left)"))">
                                @size
                                @if (isOutOfStock)
                                {
                                    <span class="text-muted small ms-1">—</span>
                                }
                            </button>
                        }
                    </div>

                    <div id="sizeWarning" class="text-danger small mt-1" style="display:none;">
                        <i class="bi bi-exclamation-circle me-1"></i>Please select a size.
                    </div>
                </div>
            }

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-dark mb-4" style="font-size:0.9rem; white-space:pre-wrap;">@Model.Description</p>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Add to Cart -->
                @if (canBuy)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" id="cartForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="variantName" id="hiddenVariant" value="" />
                        <input type="hidden" name="selectedSize" id="hiddenSize" value="" />
                        <button type="button" id="addToBagBtn" class="btn btn-dark w-100 py-3 rounded-pill fw-semibold mb-3"
                                style="font-size:1rem;"
                                onclick="addToBag(@hasSizes.ToString().ToLower(), @hasVariants.ToString().ToLower())">
                            Add to Cart
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary w-100 py-3 rounded-pill fw-semibold mb-3" disabled>
                        Out of Stock
                    </button>
                }

                <!-- Favorite -->
                <form asp-action="ToggleFavorite" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("ProductDetail", new { id = Model.Id })" />
                    <button type="submit"
                        class="btn mb-5 @(Model.IsFavorited ? "btn-danger" : "btn-outline-secondary") w-100 py-3 rounded-pill fw-semibold"
                            style="font-size:1rem;">
                        <i class="bi me-2 @(Model.IsFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                        @(Model.IsFavorited ? "Favorited" : "Favorite")
                    </button>
                </form>
            }
            else
            {
                @* Guest: buttons visible but redirect to login, returning to this product page after *@
                var loginReturn = Url.Action("Login", "Account", new { returnUrl = Context.Request.Path });

                <!-- Add to Cart -->
                @if (Model.StockStatus != "OutOfStock")
                {
                    <a href="@loginReturn"
                    class="btn btn-dark w-100 py-3 rounded-pill fw-semibold mb-3"
                    style="font-size:1rem;">
                        Add to Cart
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary w-100 py-3 rounded-pill fw-semibold mb-3" disabled>
                        Out of Stock
                    </button>
                }

                <!-- Favorite -->
                <a href="@loginReturn"
                    class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-semibold mb-4"
                    style="font-size:1rem;">
                        <i class="bi bi-heart me-2"></i>
                    Favorite
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectedVariant = null;
    let selectedSize = null;

    const stockMap = @Html.Raw(JsonSerializer.Serialize(stockMap));
    const hasVariants = @hasVariants.ToString().ToLower();
    const hasSizes = @hasSizes.ToString().ToLower();

    function normalize(value) {
        return (value || '').trim().toLowerCase();
    }

    function stockKey(variant, size) {
        return `${normalize(variant)}|${normalize(size)}`;
    }

    function getStock(variant, size) {
        return stockMap[stockKey(variant, size)] ?? 0;
    }

    function switchMainImage(src, btn) {
        document.getElementById('mainImage').src = src;
        document.querySelectorAll('.thumb-strip button, .thumb-strip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    function refreshSizeButtons() {
        if (!hasSizes) return;

        document.querySelectorAll('#sizeButtons .size-btn').forEach(btn => {
            const size = btn.dataset.size;
            let stock = 0;

            if (hasVariants === 'true' || hasVariants === true) {
                if (!selectedVariant) {
                    stock = 0;
                    btn.disabled = true;
                    btn.title = `${size} (Select a variant first)`;
                } else {
                    stock = getStock(selectedVariant, size);
                    btn.disabled = stock <= 0;
                    btn.title = stock > 0 ? `${size} (${stock} left)` : `${size} (Out of Stock)`;
                }
            } else {
                stock = getStock(null, size);
                btn.disabled = stock <= 0;
                btn.title = stock > 0 ? `${size} (${stock} left)` : `${size} (Out of Stock)`;
            }

            btn.dataset.stock = stock;
            btn.classList.toggle('stock-empty', stock <= 0);

            if (stock <= 0) {
                btn.classList.remove('selected');
            }
        });

        if (selectedSize) {
            const stillEnabled = [...document.querySelectorAll('#sizeButtons .size-btn')]
                .some(btn => btn.dataset.size === selectedSize && !btn.disabled);

            if (!stillEnabled) {
                selectedSize = null;
                const hiddenSize = document.getElementById('hiddenSize');
                if (hiddenSize) hiddenSize.value = '';
            }
        }
    }

    function selectVariant(btn) {
        if (btn.disabled) return;

        document.querySelectorAll('#variantButtons .variant-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');

        selectedVariant = btn.dataset.variant;

        const variantName = document.getElementById('variantName');
        if (variantName) variantName.textContent = selectedVariant;

        const hiddenVariant = document.getElementById('hiddenVariant');
        if (hiddenVariant) hiddenVariant.value = selectedVariant;

        const warning = document.getElementById('variantWarning');
        if (warning) warning.style.display = 'none';

        selectedSize = null;
        const hiddenSize = document.getElementById('hiddenSize');
        if (hiddenSize) hiddenSize.value = '';

        document.querySelectorAll('#sizeButtons .size-btn').forEach(b => b.classList.remove('selected'));
        refreshSizeButtons();

        const img = btn.querySelector('img');
        if (img) {
            const mainImg = document.getElementById('mainImage');
            if (mainImg) mainImg.src = img.src;
        }
    }

    function selectSize(btn) {
        if (btn.disabled) return;

        document.querySelectorAll('#sizeButtons .size-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');

        selectedSize = btn.dataset.size;

        const hiddenSize = document.getElementById('hiddenSize');
        if (hiddenSize) hiddenSize.value = selectedSize;

        const warning = document.getElementById('sizeWarning');
        if (warning) warning.style.display = 'none';
    }

    function addToBag(hasSizesParam, hasVariantsParam) {
        let valid = true;

        if (hasVariantsParam && !selectedVariant) {
            const warning = document.getElementById('variantWarning');
            if (warning) warning.style.display = 'block';
            valid = false;
        }

        if (hasSizesParam && !selectedSize) {
            const warning = document.getElementById('sizeWarning');
            if (warning) warning.style.display = 'block';
            valid = false;
        }

        if (!valid) return;

        const form = document.getElementById('cartForm');
        if (form) form.submit();
    }

    document.addEventListener('DOMContentLoaded', () => {
        refreshSizeButtons();

        // Auto-select first available variant
        if (hasVariants === 'true' || hasVariants === true) {

            const firstAvailableVariant = [...document.querySelectorAll('#variantButtons .variant-btn')]
                .find(btn => !btn.disabled);

            if (firstAvailableVariant) {
                selectVariant(firstAvailableVariant);
            }
        }

        // Auto-select first available size for products WITHOUT variants
        else if (hasSizes === 'true' || hasSizes === true) {

            const firstAvailableSize = [...document.querySelectorAll('#sizeButtons .size-btn')]
                .find(btn => !btn.disabled);

            if (firstAvailableSize) {
                selectSize(firstAvailableSize);
            }
        }
    });
</script>
}