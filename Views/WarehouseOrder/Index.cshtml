@model IEnumerable<LDMS_Final.Models.Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "_Layout";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="text-dark fw-bold mb-1">Incoming Orders</h1>
            <p class="text-dark mb-0">Manage and process customer orders.</p>
        </div>
        <a asp-action="Scan" class="btn btn-dark rounded-pill">Scan QR Code</a>
    </div>

    <!-- Status filter tabs -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        @foreach (var tab in new[]
        {
            ("Pending", "Pending"),
            ("Order approved - Preparing to ship", "Approved"),
            ("Processed", "Processed"),
        })
        {
            <a asp-action="Index" asp-route-status="@tab.Item1"
               class="btn rounded-pill px-4 @(currentStatus == tab.Item1 ? "btn-dark" : "btn-outline-secondary")">
                @tab.Item2
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-dark">
                    <i class="bi bi-inbox display-4 d-block mb-3 opacity-75"></i>
                    <p class="mb-0">No orders in this status.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Order #</th>
                                <th>Buyer</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var orderId = order.Id;
                                var orderNo = order.OrderNumber;
                                var orderName = order.DeliveryFullName;
                                var orderContact = order.DeliveryContactNumber;
                                var orderAddress = order.DeliveryAddress.Replace("'", "\\'");
                                var orderPayment = order.PaymentMethod;;
                                var orderItems = order.Items.Sum(i => i.Quantity);
                                var orderTotal = order.TotalAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

                                <tr>
                                    <td class="ps-4 fw-semibold">@order.OrderNumber</td>
                                    <td>
                                        <div class="fw-semibold small">@order.DeliveryFullName</div>
                                        <div class="text-dark small">@order.DeliveryContactNumber</div>
                                    </td>
                                    <td>@order.Items.Sum(i => i.Quantity) item(s)</td>
                                    <td class="fw-bold">₱@order.TotalAmount.ToString("N2")</td>
                                    <td>@order.PaymentMethod</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2
                                            @(order.Status == "Pending" ? "bg-warning text-dark" :
                                                  order.Status == "Order approved - Preparing to ship" ? "bg-success" : "bg-success")">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-dark small">@order.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Detail" asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3"
                                                    title="Preview Shipping Label"
                                                    onclick="previewLabel(@orderId, '@orderNo', '@orderName', '@orderContact', '@Html.Raw(orderAddress)', '@orderPayment', @orderItems, @orderTotal)">
                                                <i class="bi bi-printer"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>