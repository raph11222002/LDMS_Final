@model LDMS_Final.ViewModels.ProductStockDetailViewModel
@{
    ViewData["Title"] = "Manage Stock";
    Layout = "_Layout";

    var hasVariants = Model.StockEntries.Any(e => e.VariantName != null);
    var hasSizes = Model.StockEntries.Any(e => e.SelectedSize != null);

    // Group entries for display
    var variantGroups = Model.StockEntries
        .GroupBy(e => e.VariantName)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <a asp-action="Products" class="text-decoration-none text-dark">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
        <h1 class="text-dark fw-bold mb-1 mt-2">@Model.Name</h1>
        <p class="text-dark mb-0">@Model.Category — @Model.Brand &nbsp;|&nbsp; ₱@Model.Price.ToString("N2")</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Product Info -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Product Info</h6>

                    @{
                        var images = new[] { Model.ImagePath1, Model.ImagePath2, Model.ImagePath3,
                            Model.ImagePath4, Model.ImagePath5 }
                            .Where(x => !string.IsNullOrEmpty(x)).ToList();
                    }
                    @if (images.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var img in images)
                            {
                                <img src="@img"
                                     style="width:64px;height:64px;object-fit:cover;border-radius:8px;border:2px solid #dee2e6;" />
                            }
                        </div>
                    }

                    <p class="text-dark fw-semibold mb-1">@Model.Name</p>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-dark small mb-2" style="white-space:pre-wrap;">@Model.Description</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Sizes))
                    {
                        <div class="mb-2">
                            <span class="fw-semibold small">Available Sizes:</span>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var size in Model.Sizes.Split(','))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@size</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="mt-3 p-3 rounded-3 border border-secondary">
                        <div class="fw-semibold small text-dark">Total Stock</div>
                        <div class="fs-3 fw-bold">@Model.StockEntries.Sum(v => v.Quantity)</div>
                    </div>

                    <!-- Stock structure legend -->
                    <div class="mt-3 p-2 rounded-3 bg-light small text-dark">
                        @if (hasVariants && hasSizes)
                        {
                            <i class="bi bi-info-circle me-1"></i>
                            <span>Stock is tracked per <strong>variant + size</strong> combination.</span>
                        }
                        else if (hasVariants)
                        {
                            <i class="bi bi-info-circle me-1"></i>
                            <span>Stock is tracked per <strong>variant</strong>. No sizes for this product.</span>
                        }
                        else if (hasSizes)
                        {
                            <i class="bi bi-info-circle me-1"></i>
                            <span>Stock is tracked per <strong>size</strong>. No variants for this product.</span>
                        }
                        else
                        {
                            <i class="bi bi-info-circle me-1"></i>
                            <span>Single stock entry — no variants or sizes.</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock Management -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">
                        @if (hasVariants && hasSizes)
                        {
                            <text>Stock per Variant &amp; Size</text>
                        }
                        else if (hasVariants)
                        {
                            <text>Stock per Variant</text>
                        }
                        else if (hasSizes)
                        {
                            <text>Stock per Size</text>
                        }
                        else
                        {
                            <text>Stock</text>
                        }
                    </h6>

                    <form asp-action="UpdateStock" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.ProductId" />

                        @{
                            int inputIndex = 0;
                        }

                        @if (hasVariants)
                        {
                            @* Group by variant, then show sizes inside *@
                            @foreach (var vGroup in variantGroups)
                            {
                                var firstEntry = vGroup.First();
                                <div class="mb-4">
                                    <!-- Variant header -->
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        @if (!string.IsNullOrEmpty(firstEntry.VariantImagePath))
                                        {
                                            <img src="@firstEntry.VariantImagePath"
                                                 style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1.5px solid #dee2e6;" />
                                        }
                                        else
                                        {
                                            <div
                                                style="width:40px;height:40px;background:#f0f2f5;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-palette text-dark" style="font-size:1rem;"></i>
                                            </div>
                                        }
                                        <span class="fw-semibold">@(vGroup.Key ?? "Default")</span>
                                    </div>

                                    <!-- Size rows under this variant -->
                                    <div class="d-flex flex-column gap-2 ps-3 border-start border-2">
                                        @foreach (var entry in vGroup)
                                        {
                                            <input type="hidden" name="Stocks[@inputIndex].StockId" value="@entry.StockId" />
                                            <input type="hidden" name="Stocks[@inputIndex].VariantName"
                                                   value="@entry.VariantName" />
                                            <input type="hidden" name="Stocks[@inputIndex].SelectedSize"
                                                   value="@entry.SelectedSize" />

                                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 border bg-light">
                                                @if (!string.IsNullOrEmpty(entry.SelectedSize))
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2"
                                                          style="min-width:50px;text-align:center;font-size:0.85rem;">
                                                        @entry.SelectedSize
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-dark small">No size</span>
                                                }

                                                <div style="width:110px;">
                                                    <input type="number" name="Stocks[@inputIndex].Quantity" value="@entry.Quantity"
                                                           min="0" class="form-control form-control-sm" />
                                                </div>

                                                <input type="text" name="Stocks[@inputIndex].Note"
                                                       class="form-control form-control-sm" placeholder="Note (optional)"
                                                       style="max-width:200px;" />

                                                <div class="ms-auto flex-shrink-0">
                                                    @if (entry.Quantity == 0)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2">Out</span>
                                                    }
                                                    else if (entry.Quantity <= 5)
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2">Low</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success rounded-pill px-2">OK</span>
                                                    }
                                                </div>
                                            </div>

                                            inputIndex++;
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @* No variants — flat size list or single entry *@
                            <div class="d-flex flex-column gap-2">
                                @foreach (var entry in Model.StockEntries)
                                {
                                    <input type="hidden" name="Stocks[@inputIndex].StockId" value="@entry.StockId" />
                                    <input type="hidden" name="Stocks[@inputIndex].VariantName" value="@entry.VariantName" />
                                    <input type="hidden" name="Stocks[@inputIndex].SelectedSize" value="@entry.SelectedSize" />

                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 border">
                                        @if (!string.IsNullOrEmpty(entry.SelectedSize))
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2"
                                                  style="min-width:60px;text-align:center;font-size:0.9rem;">
                                                @entry.SelectedSize
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold text-dark small">Stock</span>
                                        }

                                        <div style="width:110px;">
                                            <input type="number" name="Stocks[@inputIndex].Quantity" value="@entry.Quantity"
                                                   min="0" class="form-control form-control-sm" />
                                        </div>

                                        <input type="text" name="Stocks[@inputIndex].Note" class="form-control form-control-sm"
                                               placeholder="Note (optional)" style="max-width:200px;" />

                                        <div class="ms-auto flex-shrink-0">
                                            @if (entry.Quantity == 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-2">Out</span>
                                            }
                                            else if (entry.Quantity <= 5)
                                            {
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-2">Low</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-2">OK</span>
                                            }
                                        </div>
                                    </div>

                                    inputIndex++;
                                }
                            </div>
                        }

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-2"></i>Save Stock
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Stock History -->
        @if (Model.StockLogs.Any())
        {
            <div class="col-12">
                <div class="card border-0 rounded-4 shadow-sm">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3">Stock History</h6>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Variant</th>
                                        <th>Size</th>
                                        <th>Previous</th>
                                        <th>New</th>
                                        <th>Change</th>
                                        <th>Updated By</th>
                                        <th>Note</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.StockLogs)
                                    {
                                        <tr>
                                            <td>@(log.VariantName ?? "—")</td>
                                            <td>@(log.SelectedSize ?? "—")</td>
                                            <td>@log.PreviousQuantity</td>
                                            <td>@log.NewQuantity</td>
                                            <td>
                                                @if (log.Change > 0)
                                                {
                                                    <span class="text-success fw-semibold">+@log.Change</span>
                                                }
                                                else if (log.Change < 0)
                                                {
                                                    <span class="text-danger fw-semibold">@log.Change</span>
                                                }
                                                else
                                                {
                                                    <span class="text-dark">0</span>
                                                }
                                            </td>
                                            <td>@log.UpdatedByName</td>
                                            <td class="text-dark small">@(log.Note ?? "—")</td>
                                            <td class="text-dark small">@log.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>