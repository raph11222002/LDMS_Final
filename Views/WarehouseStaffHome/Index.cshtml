@model LDMS_Final.ViewModels.WarehouseStaffDashboardViewModel
@{
    ViewData["Title"] = "Warehouse Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h1 class="text-dark fw-bold mb-1">Warehouse Dashboard</h1>
        <p class="text-dark mb-0">Monitor and manage product stock levels.</p>
    </div>

    <div class="row g-4">

        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-action="Products" class="text-decoration-none">
                <div class="dashboard-card dashboard-card--blue h-100">
                    <div class="dashboard-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="dashboard-card-title">Total Products</h5>
                            <div class="dashboard-card-icon">
                                <i class="bi bi-bag-fill"></i>
                            </div>
                        </div>
                        <div class="dashboard-card-number">@Model.TotalProductCount</div>
                        <p class="dashboard-card-desc">All active products to manage.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dashboard-card dashboard-card--teal h-100">
                <div class="dashboard-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="dashboard-card-title">In Stock</h5>
                        <div class="dashboard-card-icon">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </div>
                    <div class="dashboard-card-number">@Model.InStockCount</div>
                    <p class="dashboard-card-desc">Products with sufficient stock.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dashboard-card dashboard-card--warning h-100">
                <div class="dashboard-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="dashboard-card-title">Low Stock</h5>
                        <div class="dashboard-card-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                    <div class="dashboard-card-number">@Model.LowStockCount</div>
                    <p class="dashboard-card-desc">Products with 5 or fewer units.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="dashboard-card dashboard-card--danger h-100">
                <div class="dashboard-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="dashboard-card-title">Out of Stock</h5>
                        <div class="dashboard-card-icon">
                            <i class="bi bi-x-circle-fill"></i>
                        </div>
                    </div>
                    <div class="dashboard-card-number">@Model.OutOfStockCount</div>
                    <p class="dashboard-card-desc">Products with zero stock.</p>
                </div>
            </div>
        </div>

    </div>
</div>