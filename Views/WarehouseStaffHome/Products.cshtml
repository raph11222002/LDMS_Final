@model IEnumerable<LDMS_Final.ViewModels.ProductStockListViewModel>
@{
    ViewData["Title"] = "Product Stock";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4">

    <div class="mb-4">
        <h1 class="text-dark fw-bold mb-1">Product Stock</h1>
        <p class="text-dark mb-0">Click a product to manage its stock.</p>
    </div>

    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-dark">
                    <i class="bi bi-bag display-4 d-block mb-3 opacity-75"></i>
                    <p class="mb-0">No products assigned to your warehouse yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Image</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Total Stock</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr style="cursor:pointer;"
                                    onclick="window.location='@Url.Action("ProductDetail", new { id = product.ProductId })'">
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(product.ImagePath1))
                                        {
                                            <img src="@product.ImagePath1" alt="@product.Name"
                                                 style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <div
                                                style="width:48px;height:48px;background:#f0f2f5;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-image text-dark"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-semibold">@product.Name</td>
                                    <td>
                                        <span
                                        class="badge bg-primary-subtle text-primary rounded-pill px-3">@product.Category</span>
                                    </td>
                                    <td>@product.Brand</td>
                                    <td class="fw-bold">@product.TotalStock</td>
                                    <td>
                                        @switch (product.StockStatus)
                                        {
                                            case "InStock":
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3">In Stock</span>
                                                break;
                                            case "LowStock":
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>Low Stock
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Out of Stock</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ProductDetail" asp-route-id="@product.ProductId"
                                           class="btn btn-sm btn-outline-primary rounded-3" onclick="event.stopPropagation()">
                                            <i class="bi bi-box-seam me-1"></i> Manage Stock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>