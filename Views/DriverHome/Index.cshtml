@model LDMS_Final.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Dashboard";
    Layout = "_Layout";
}

<style>
    .stat-card {
        transition: transform .15s;
        min-height: 110px;
        transition: .2s ease;
    }

    .stat-card:active {
        transform: scale(.97);
    }

    .stop-card {
        transition: box-shadow .15s;
    }

    .stop-card:active {
        box-shadow: 0 0 0 2px #0d6efd33;
    }

    .active-stat {
        border-width: 0.1rem !important;
        border-style: solid !important;
    }

    .active-primary {
        border-color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.1) !important;
    }

    .active-warning {
        border-color: #ffc107 !important;
        background-color: rgba(255, 193, 7, 0.1) !important;
    }

    .active-success {
        border-color: #198754 !important;
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    @@media (max-width: 576px) {
        .all-cards {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .stat-number {
            font-size: 1.15rem !important;
        }

        .stat-label {
            font-size: .68rem !important;
        }

        .stat-icon {
            font-size: 1rem !important;
        }

        .stop-order-badge {
            width: 34px !important;
            height: 34px !important;
            font-size: 1rem !important;
        }

        .stat-card {
            min-height: 96px;
            border-radius: 2rem !important;
            transition: .2s ease;
        }

        .stop-card .scan-btn {
            width: 100%;
            justify-content: center;
        }

        .stop-card .stop-info {
            width: 100%;
        }
    }
</style>

<div class="container-fluid py-3 px-2 px-sm-4" style="background:#fff; min-height:100vh;">

    <!-- Header -->
    <div class="mb-3">
        <h1 class="fw-bold mb-1 fs-4 fs-sm-2" style="color:#111;">
            <i class="bi bi-truck-front me-2 text-primary"></i>Driver Dashboard
        </h1>
        <p class="text-dark mb-0 small">
            Welcome, <strong>@Model.Driver.FullName</strong>
            <span class="badge bg-secondary ms-1" style="font-size:.7rem;">
                @(Model.Driver.AssignedHub switch
                {
                    null => "Warehouse Driver",
                    LDMS_Final.Models.DeliveryHub.Davao => "Davao Hub",
                    LDMS_Final.Models.DeliveryHub.Surigao => "Surigao Hub",
                    LDMS_Final.Models.DeliveryHub.Tacloban => "Tacloban Hub",
                    LDMS_Final.Models.DeliveryHub.Pasay => "Pasay Hub",
                    _ => "Unknown Hub"
                })
            </span>
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 small">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="d-flex justify-content-between mb-3 gap-3 flex-wrap all-cards">
        <div class="col border-0 rounded-4 shadow-lg text-decoration-none stat-card
            @(Model.ActiveFilter == "Pending" ? "active-stat active-primary" : "")">
            <a asp-action="Index" asp-route-filter="Pending" class="text-decoration-none">
                <div
                    class="card-body p-2 p-sm-3 d-flex flex-column align-items-center justify-content-center text-center gap-1">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-2 mb-1">
                        <i class="bi bi-hourglass-split text-primary stat-icon fs-6"></i>
                    </div>
                    <div class="fw-bold stat-number" style="font-size:1.6rem;line-height:1;">@Model.PendingCount</div>
                    <small class="text-dark stat-label" style="font-size:.75rem;">Pending</small>
                </div>
            </a>
        </div>

        <div class="col border-0 rounded-4 shadow-lg text-decoration-none stat-card
            @(Model.ActiveFilter == "InTransit" ? "active-stat active-warning" : "")">
            <a asp-action="Index" asp-route-filter="InTransit" class="text-decoration-none">
                <div
                    class="card-body p-2 p-sm-3 d-flex flex-column align-items-center justify-content-center text-center gap-1">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-2 mb-1">
                        <i class="bi bi-truck text-warning stat-icon fs-6"></i>
                    </div>
                    <div class="fw-bold stat-number" style="font-size:1.6rem;line-height:1;">@Model.InTransitCount</div>
                    <small class="text-dark stat-label" style="font-size:.75rem;">In Transit</small>
                </div>
            </a>
        </div>

        <div class="col border-0 rounded-4 shadow-lg text-decoration-none stat-card
            @(Model.ActiveFilter == "Completed" ? "active-stat active-success" : "")">
            <a asp-action="Index" asp-route-filter="Completed" class="text-decoration-none">
                <div
                    class="card-body p-2 p-sm-3 d-flex flex-column align-items-center justify-content-center text-center gap-1">
                    <div class="rounded-3 bg-success bg-opacity-10 p-2 mb-1">
                        <i class="bi bi-check-circle text-success stat-icon fs-6"></i>
                    </div>
                    <div class="fw-bold stat-number" style="font-size:1.6rem;line-height:1;">@Model.CompletedCount</div>
                    <small class="text-dark stat-label" style="font-size:.75rem;">Completed</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Stop List -->
    <div class="card border-0 rounded-4 shadow-lg">
        <div class="card-header bg-white border-0 pt-3 pb-0 px-3 px-sm-4">
            <h6 class="fw-bold mb-0 small">
                @if (Model.ActiveFilter == "Pending")
                {
                    <i class="bi bi-hourglass-split me-2 text-primary"></i>
                    <text>Pending Pickups</text>
                }
                else if (Model.ActiveFilter == "InTransit")
                {
                    <i class="bi bi-truck me-2 text-warning"></i>
                    <text>Currently In Transit</text>
                }
                else
                {
                    <i class="bi bi-check-circle me-2 text-success"></i>
                    <text>Completed Deliveries</text>
                }
            </h6>
        </div>

        <div class="card-body px-3 px-sm-4 py-3">
            @if (!Model.AllStops.Any())
            {
                <div class="text-center py-5 text-dark">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                    <div class="small">No assignments in this category.</div>
                </div>
            }

            @foreach (var stop in Model.AllStops)
            {
                var order = stop.RouteAssignment.Order;
                bool isFinalLeg = stop.DriverLabel == "motorcycle driver";

                <div class="stop-card d-flex flex-column flex-sm-row align-items-stretch gap-2 p-3 rounded-3 border mb-2
                    @(stop.StopStatus == HubStopStatus.InTransit ? "border-warning bg-warning bg-opacity-10" :
                       stop.StopStatus == HubStopStatus.Arrived ? "border-success bg-success bg-opacity-10" :
                       "border-primary bg-primary bg-opacity-10")">

                    <!-- Number badge -->
                    <div class="stop-order-badge rounded-circle text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                         style="width:38px;height:38px;font-size:1.5rem;
                        background:@(stop.StopStatus == HubStopStatus.InTransit ? "#ffc107" :
                                                    stop.StopStatus == HubStopStatus.Arrived ? "#198754" : "#0d6efd")">
                        @(stop.StopOrder + 1)
                    </div>

                    <!-- Info — clicking this navigates to detail -->
                    <a asp-action="OrderDetail" asp-route-id="@order.Id"
                       class="stop-info flex-grow-1 min-w-0 text-decoration-none">
                        <div class="fw-semibold text-dark" style="font-size:.9rem; word-break:break-word;">
                            @order.OrderNumber
                        </div>
                        <div class="small text-dark" style="word-break:break-word;">
                            <i class="bi bi-geo-alt me-1"></i>
                            @(isFinalLeg ? "Door-to-door delivery" : stop.HubLabel)
                        </div>
                        <div class="small text-dark" style="word-break:break-word;">
                            <i class="bi bi-person me-1"></i>@order.Buyer?.FullName
                        </div>
                        <div class="d-flex gap-1 mt-1 flex-wrap">
                            <span class="badge bg-secondary" style="font-size:.68rem;">
                                @(isFinalLeg ? "motorcycle driver" : stop.DriverLabel)
                            </span>
                            <span class="badge rounded-pill
                                @(stop.StopStatus == HubStopStatus.InTransit ? "bg-warning text-dark" :
                                    stop.StopStatus == HubStopStatus.Arrived ? "bg-success" :
                                    stop.StopStatus == HubStopStatus.Completed ? "bg-secondary" : "bg-primary")"
                                  style="font-size:.68rem;">
                                @stop.StopStatus
                            </span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>