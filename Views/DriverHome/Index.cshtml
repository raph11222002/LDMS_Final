@model LDMS_Final.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4" style="background:#fff; min-height:100vh;">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1" style="color:#111;">
                <i class="bi bi-truck-front me-2 text-primary"></i>Driver Dashboard
            </h1>
            <p class="text-dark mb-0">
                Welcome, <strong>@Model.Driver.FullName</strong>
                <span class="badge bg-secondary ms-2">
                    @(Model.Driver.AssignedHub switch
                    {
                        null => "Warehouse Driver",
                        LDMS_Final.Models.DeliveryHub.Davao => "Davao Hub Driver",
                        LDMS_Final.Models.DeliveryHub.Surigao => "Surigao Hub Driver",
                        LDMS_Final.Models.DeliveryHub.Tacloban => "Tacloban Hub Driver",
                        LDMS_Final.Models.DeliveryHub.Pasay => "Pasay Hub Driver",
                        _ => "Unknown Hub Driver"
                    })
                </span>
            </p>
        </div>
        <a asp-action="Scan" class="btn btn-dark rounded-pill px-4">
            <i class="bi bi-qr-code-scan me-2"></i>Scan QR
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <a asp-action="Index" asp-route-filter="Pending" class="card border-0 rounded-4 shadow-lg text-decoration-none h-100
                @(Model.ActiveFilter == "Pending" ? "border border-primary border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-2">
                        <i class="bi bi-hourglass-split text-primary fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.PendingCount</div>
                        <small class="text-dark">Pending</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-4">
            <a asp-action="Index" asp-route-filter="InTransit" class="card border-0 rounded-4 shadow-lg text-decoration-none h-100
                @(Model.ActiveFilter == "InTransit" ? "border border-warning border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-2">
                        <i class="bi bi-truck text-warning fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.InTransitCount</div>
                        <small class="text-dark">In Transit</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-4">
            <a asp-action="Index" asp-route-filter="Completed" class="card border-0 rounded-4 shadow-lg text-decoration-none h-100
                @(Model.ActiveFilter == "Completed" ? "border border-success border-2" : "")">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 p-2">
                        <i class="bi bi-check-circle text-success fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 lh-1">@Model.CompletedCount</div>
                        <small class="text-dark">Completed</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Stop List -->
    <div class="card border-0 rounded-4 shadow-lg">
        <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
            <h6 class="fw-bold mb-0">
                @if (Model.ActiveFilter == "Pending")
                {
                    <i class="bi bi-hourglass-split me-2 text-primary"></i>
                    <text>Pending Pickups</text>
                }
                else if (Model.ActiveFilter == "InTransit")
                {
                    <i class="bi bi-truck me-2 text-warning"></i>
                    <text>Currently In Transit</text>
                }
                else
                {
                    <i class="bi bi-check-circle me-2 text-success"></i>
                    <text>Completed Deliveries</text>
                }
            </h6>
        </div>
        <div class="card-body px-4 py-3">
            @if (!Model.AllStops.Any())
            {
                <div class="text-center py-5 text-dark">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                    No assignments in this category.
                </div>
            }
            @foreach (var stop in Model.AllStops)
            {
                var order = stop.RouteAssignment.Order;
                <div class="d-flex align-items-start gap-3 p-3 rounded-3 border mb-2
                    @(stop.StopStatus == HubStopStatus.InTransit ? "border-warning bg-warning bg-opacity-10" :
                       stop.StopStatus == HubStopStatus.Arrived ? "border-success bg-success bg-opacity-10" :
                       "border-light")">

                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                         style="width:40px;height:40px;font-size:.85rem;
                        background:@(stop.StopStatus == HubStopStatus.InTransit ? "#ffc107" :
                                                                      stop.StopStatus == HubStopStatus.Arrived ? "#198754" : "#0d6efd")">
                        @(stop.StopOrder + 1)
                    </div>

                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold">@order.OrderNumber</div>
                        <div class="small text-dark">
                            <i class="bi bi-geo-alt me-1"></i>@stop.HubLabel
                        </div>
                        <div class="small text-dark">
                            <i class="bi bi-person me-1"></i>@order.Buyer?.FullName
                        </div>
                        <div class="d-flex gap-2 mt-1 flex-wrap">
                            <span class="badge bg-secondary">@stop.DriverLabel</span>
                            <span class="badge rounded-pill
                                @(stop.StopStatus == HubStopStatus.InTransit ? "bg-warning text-dark" :
                                    stop.StopStatus == HubStopStatus.Arrived ? "bg-success" :
                                    stop.StopStatus == HubStopStatus.Completed ? "bg-secondary" : "bg-primary")">
                                @stop.StopStatus
                            </span>
                        </div>
                    </div>

                    <div class="flex-shrink-0 d-flex flex-column gap-2">
                        @if (stop.StopStatus == HubStopStatus.Pending)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stopId" value="@stop.Id" />
                                <input type="hidden" name="action" value="start" />
                                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3">
                                    <i class="bi bi-truck me-1"></i>Start Trip
                                </button>
                            </form>
                        }
                        else if (stop.StopStatus == HubStopStatus.InTransit)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stopId" value="@stop.Id" />
                                <input type="hidden" name="action" value="arrived" />
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                    <i class="bi bi-check2 me-1"></i>Mark Arrived
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>