@{
    ViewData["Title"] = "Order Placed";
    Layout = "_Layout";
}

<div class="container-fluid py-5 px-4" style="background:#fff; min-height:100vh;">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 text-center">
            <div class="card border-0 rounded-4 shadow-lg p-5">
                <i class="bi bi-check-circle-fill text-success mb-3" style="font-size:3.5rem;"></i>
                <h2 class="text-success fw-bold mb-2">Order Placed!</h2>
                <p class="text-dark mb-1">Your order number is:</p>
                <div class="fs-4 fw-bold mb-4" style="color:#111;">@ViewBag.OrderNumber</div>
                <p class="text-dark small mb-4">
                    We've received your order. Our warehouse team will prepare it shortly.
                    You'll be able to track your order status from your Orders page.
                </p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-dark rounded-pill px-4">View My
                        Orders
                    </a>
                    <a asp-controller="BuyerHome" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>