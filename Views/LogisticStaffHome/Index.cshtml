@model LDMS_Final.ViewModels.LogisticStaffDashboardViewModel
@{
    ViewData["Title"] = "Logistic Staff Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h1 class="fw-bold mb-1 text-dark">Logistic Staff Dashboard</h1>
    </div>

    <div class="row g-4">

        <div class="col-12 col-lg-4">
            <a asp-controller="DriverManagement" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card dashboard-card--blue h-100">
                    <div class="dashboard-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="dashboard-card-title">Total Drivers</h5>
                            <div class="dashboard-card-icon">
                                <i class="bi bi-truck"></i>
                            </div>
                        </div>
                        <div class="dashboard-card-number">@Model.TotalDriverCount</div>
                        <p class="dashboard-card-desc">All driver accounts you manage.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-lg-4">
            <div class="dashboard-card dashboard-card--teal h-100">
                <div class="dashboard-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="dashboard-card-title">Active Drivers</h5>
                        <div class="dashboard-card-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                    </div>
                    <div class="dashboard-card-number">@Model.ActiveDriverCount</div>
                    <p class="dashboard-card-desc">Currently active drivers.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="dashboard-card dashboard-card--indigo h-100">
                <div class="dashboard-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="dashboard-card-title">Inactive Drivers</h5>
                        <div class="dashboard-card-icon">
                            <i class="bi bi-person-dash-fill"></i>
                        </div>
                    </div>
                    <div class="dashboard-card-number">@Model.InactiveDriverCount</div>
                    <p class="dashboard-card-desc">Currently inactive drivers.</p>
                </div>
            </div>
        </div>

    </div>
</div>