@model IEnumerable<LDMS_Final.ViewModels.CartItemViewModel>
@{
    ViewData["Title"] = "My Cart";
    Layout = "_Layout";
    var items = Model.ToList();
}

<style>
    .cart-page {
        background: #f4f5f7;
    }

    .cart-card,
    .cart-summary {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 1.5rem;
        overflow: hidden;
    }

    .cart-card .card-body {
        background: #ffffff;
    }

    .cart-card .product-title,
    .cart-summary h6,
    .cart-card .fw-bold {
        color: #111111;
    }

    .cart-card .product-meta,
    .cart-summary .text-dark,
    .cart-card small {
        color: #6c757d;
    }

    .cart-card .border-bottom {
        border-color: #e9ecef !important;
    }

    .cart-card img,
    .cart-card .image-placeholder {
        background: #f8f9fa;
    }

    .cart-card .btn-outline-secondary {
        color: #495057;
        border-color: #ced4da;
    }

    .cart-summary .btn-outline-secondary {
        color: #111111;
        border-color: #ced4da;
    }

    .cart-summary .btn-dark {
        background-color: #111111;
        border-color: #111111;
    }

    .cart-card .remove-button {
        color: #d63384;
    }

    .cart-empty {
        color: #6c757d;
    }
</style>

<div class="container-fluid py-4 px-4 cart-page" style="min-height:100vh;">

    <div class="mb-4">
        <h1 class="fw-bold mb-1" style="color:#111;">My Cart</h1>
        <p class="text-dark mb-0">@items.Count item(s) in your cart.</p>
    </div>

    @if (!items.Any())
    {
        <div class="text-center py-5 text-dark">
            <i class="bi bi-cart-x display-4 d-block mb-3 opacity-50"></i>
            <p class="mb-2">Your cart is empty.</p>
            <a asp-controller="BuyerHome" asp-action="Index" class="btn btn-dark rounded-pill px-4">Browse Products</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card cart-card rounded-4 shadow-lg">
                    <div class="card-body p-0">
                        @foreach (var item in items)
                        {
                            <div class="d-flex align-items-start gap-3 p-3 border-bottom">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath"
                                         style="width:100px;height:120px;object-fit:cover;border-radius:8px;flex-shrink:0;border:1px solid #000;" />
                                }
                                else
                                {
                                    <div
                                        style="width:100px;height:120px;background:#f5f5f5;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border:1px solid #000;">
                                        <i class="bi bi-image text-dark"></i>
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <div class="product-title fw-semibold">@item.ProductName</div>
                                    <div class="product-meta small">
                                        @if (!string.IsNullOrEmpty(item.VariantName))
                                        {
                                            <span>@item.VariantName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SelectedSize))
                                        {
                                            <span class="ms-1">/ @item.SelectedSize</span>
                                        }
                                    </div>
                                    <div class="fw-bold mt-1" style="color:#111;">₱@item.UnitPrice.ToString("N2")</div>

                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post"
                                              class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    style="width:30px;height:30px;padding:0;">−</button>
                                            <span class="px-2 fw-semibold">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    style="width:30px;height:30px;padding:0;" @(item.Quantity >= item.AvailableStock
                                                                                            ? "disabled" : "")>+</button>
                                        </form>

                                        <form asp-controller="Cart" asp-action="Remove" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="btn btn-sm btn-link remove-button p-0">
                                                <i class="bi bi-trash"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="text-end flex-shrink-0">
                                    <div class="fw-bold" style="color:#111;">₱@item.Subtotal.ToString("N2")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card cart-summary rounded-4 shadow-lg">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3">Order Summary</h6>
                        @foreach (var item in items)
                        {
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-dark">@item.ProductName x @item.Quantity</span>
                                <span>₱@item.Subtotal.ToString("N2")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total</span>
                            <span>₱@items.Sum(i => i.Subtotal).ToString("N2")</span>
                        </div>
                        <a asp-controller="Checkout" asp-action="Index"
                           class="btn btn-dark w-100 rounded-pill py-2 mt-3 fw-semibold">
                            Proceed to Checkout
                        </a>
                        <a asp-controller="BuyerHome" asp-action="Index"
                           class="btn btn-outline-secondary w-100 rounded-pill py-2 mt-2">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>