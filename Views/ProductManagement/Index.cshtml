@model IEnumerable<LDMS_Final.Models.Product>
@{
    ViewData["Title"] = "Product Management";
    Layout = "_Layout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-dark fw-bold mb-1">Product Management</h1>
            <p class="text-dark mb-0">Manage product listings.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-dark">
                    <i class="bi bi-bag display-4 d-block mb-3 opacity-50"></i>
                    <p class="mb-0">No products yet. Click <strong>Add Product</strong> to get started.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Sizes</th>
                                <th>Variants</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(product.ImagePath1))
                                        {
                                            <img src="@product.ImagePath1" alt="@product.Name"
                                                 style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <div
                                                style="width:48px;height:48px;background:#f0f2f5;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-image text-dark"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-semibold">@product.Name</td>
                                    <td>
                                        <span
                                        class="badge bg-primary-subtle text-primary rounded-pill px-3">@product.Category</span>
                                    </td>
                                    <td>@product.Brand</td>
                                    <td style="max-width: 260px;">
                                        @if (!string.IsNullOrEmpty(product.Sizes))
                                        {
                                            <div class="sizes-scroll d-flex flex-nowrap gap-1 overflow-auto py-1">
                                                @foreach (var size in product.Sizes.Split(','))
                                                {
                                                    <span
                                                        class="badge bg-secondary-subtle text-secondary rounded-pill px-2 flex-shrink-0">
                                                        @size
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-dark small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.VariantsJson))
                                        {
                                            var variants =
                                System.Text.Json.JsonSerializer.Deserialize<List<LDMS_Final.Models.ProductVariant>>(product.VariantsJson);
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var v in variants!)
                                                {
                                                    <span class="badge bg-info-subtle text-info rounded-pill px-2">@v.Name</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-dark small align-middle">—</span>
                                        }
                                    </td>
                                    <td>₱@product.Price.ToString("N2")</td>
                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@product.Id" method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm @(product.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-3"
                                                        title="@(product.IsActive ? "Deactivate" : "Activate")">
                                                    <i
                                                    class="bi @(product.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete @product.Name?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>