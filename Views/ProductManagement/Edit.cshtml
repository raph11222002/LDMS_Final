@model LDMS_Final.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
        <h1 class="text-dark fw-bold mb-1 mt-2">Edit Product</h1>
        <p class="text-dark mb-0">Update product details.</p>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImagePath1" />
                        <input type="hidden" asp-for="ImagePath2" />
                        <input type="hidden" asp-for="ImagePath3" />
                        <input type="hidden" asp-for="ImagePath4" />
                        <input type="hidden" asp-for="ImagePath5" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                        <div class="row g-3">

                            <!-- Product Name -->
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Category — free text -->
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-semibold"></label>
                                <input asp-for="Category" class="form-control"
                                       placeholder="e.g. T-Shirt, Backpack, Shoes" />
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <!-- Brand -->
                            <div class="col-md-6">
                                <label asp-for="Brand" class="form-label fw-semibold"></label>
                                <input asp-for="Brand" class="form-control" />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>

                            <!-- Price -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <!-- Weight -->
                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0.01" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <span asp-validation-for="Weight" class="text-danger small"></span>
                                <div class="form-text">Include the box/package weight in the total weight.</div>
                            </div>

                            <!-- Sizes — pre-populated from existing data -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Available Sizes
                                    <span class="text-muted fw-normal small">(optional — leave empty for one-size
                                        products like bags)</span>
                                    </label>
                                    <div id="sizesContainer" class="d-flex flex-wrap gap-2 mb-2"></div>
                                    <div class="d-flex gap-2">
                                        <input type="text" id="sizeInput" class="form-control form-control-sm w-auto"
                                               placeholder="e.g. S, M, L, XL, 42" style="min-width:120px;"
                                               onkeydown="if(event.key==='Enter'){event.preventDefault();addSize();}" />
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addSize()">
                                            <i class="bi bi-plus-lg"></i> Add Size
                                        </button>
                                    </div>
                                    <div id="hiddenSizes"></div>
                                    <div class="form-text">Click a size tag to remove it.</div>
                                </div>

                                <!-- Variants — pre-populated from existing data -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        Variants
                                        <span class="text-muted fw-normal small">(e.g. Red, Ocean Blue, Stripe
                                            Pattern)</span>
                                        </label>
                                        <div id="variantsContainer" class="d-flex flex-column gap-2 mb-2"></div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addVariant()">
                                            <i class="bi bi-plus-lg"></i> Add Variant
                                        </button>
                                        <div class="form-text">Each variant can have one image (JPG, PNG, WEBP only).</div>
                                    </div>

                                    <!-- Description -->
                                    <div class="col-12">
                                        <label asp-for="Description" class="form-label fw-semibold"></label>
                                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Description" class="text-danger small"></span>
                                    </div>

                                    <!-- Existing main images -->
                                    @{
                                        var existingImages = new[] { Model.ImagePath1, Model.ImagePath2, Model.ImagePath3,
                            Model.ImagePath4, Model.ImagePath5 }
                                            .Where(x => !string.IsNullOrEmpty(x)).ToList();
                                    }
                                    @if (existingImages.Any())
                                    {
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Current Images</label>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var img in existingImages)
                                                {
                                                    <img src="@img"
                                                         style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:2px solid #dee2e6;" />
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Replace main images -->
                                    <div class="col-12">
                                        <label asp-for="Images" class="form-label fw-semibold">Replace Images (optional)</label>
                                        <input asp-for="Images" class="form-control" type="file" multiple
                                               accept=".jpg,.jpeg,.png,.webp" onchange="previewImages(event)" />
                                        <div class="form-text">Upload new images to replace existing ones. Max 5. JPG, PNG, WEBP
                                            only.</div>
                                            <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-2"></div>
                                        </div>

                                        <!-- Active toggle -->
                                        <div class="col-12">
                                            <div class="form-check form-switch">
                                                <input asp-for="IsActive" class="form-check-input" role="switch" />
                                                <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="d-flex gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi bi-save me-2"></i>Save Changes
                                        </button>
                                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
                <script>
                    // ── Pre-populate existing sizes from model ─────────────
                    const sizes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sizes ?? new List<string>()));
                    renderSizes();

                    // ── Pre-populate existing variants from model ──────────
                    let variantCount = 0;
                    const existingVariants = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            (Model.Variants ?? new List<LDMS_Final.ViewModels.ProductVariantViewModel>())
                                .Select(v => new { v.Name, v.ExistingImagePath }
                            )
                        )
                    );
                    existingVariants.forEach(v => addVariant(v.Name, v.ExistingImagePath));

                    // ── Sizes ──────────────────────────────────────────────
                    function addSize() {
                        const input = document.getElementById('sizeInput');
                        const val = input.value.trim();
                        if (!val || sizes.includes(val)) { input.value = ''; return; }
                        sizes.push(val);
                        renderSizes();
                        input.value = '';
                        input.focus();
                    }

                    function removeSize(size) {
                        const i = sizes.indexOf(size);
                        if (i > -1) sizes.splice(i, 1);
                        renderSizes();
                    }

                    function renderSizes() {
                        const container = document.getElementById('sizesContainer');
                        const hidden = document.getElementById('hiddenSizes');
                        container.innerHTML = '';
                        hidden.innerHTML = '';
                        sizes.forEach(size => {
                            const tag = document.createElement('span');
                            tag.className = 'badge bg-primary-subtle text-primary rounded-pill px-3 py-2 d-flex align-items-center gap-1';
                            tag.style.cursor = 'pointer';
                            tag.title = 'Click to remove';
                            tag.innerHTML = `${size} <i class="bi bi-x-lg" style="font-size:0.65rem;"></i>`;
                            tag.onclick = () => removeSize(size);
                            container.appendChild(tag);

                            const inp = document.createElement('input');
                            inp.type = 'hidden';
                            inp.name = 'Sizes';
                            inp.value = size;
                            hidden.appendChild(inp);
                        });
                    }

                    // ── Variants ───────────────────────────────────────────
                    function addVariant(existingName = '', existingImage = null) {
                        const container = document.getElementById('variantsContainer');
                        const index = variantCount++;
                        const allowed = '.jpg,.jpeg,.png,.webp';

                        const row = document.createElement('div');
                        row.className = 'd-flex align-items-center gap-2 flex-wrap';
                        row.id = `variant-${index}`;

                        const existingImgHtml = existingImage
                            ? `<img src="${existingImage}" id="variantPreview-${index}"
                                        style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:2px solid #dee2e6;" />`
                            : `<img id="variantPreview-${index}"
                                        style="display:none;width:48px;height:48px;object-fit:cover;border-radius:8px;border:2px solid #dee2e6;" />`;

                        row.innerHTML = `
                                <input type="text" name="Variants[${index}].Name" class="form-control form-control-sm"
                                       placeholder="Variant name (e.g. Red, Ocean Blue)"
                                       style="max-width:220px;" value="${existingName}" />
                                ${existingImage ? `<input type="hidden" name="Variants[${index}].ExistingImagePath" value="${existingImage}" />` : ''}
                                <input type="file" name="Variants[${index}].Image" class="form-control form-control-sm"
                                       accept="${allowed}" style="max-width:240px;"
                                       onchange="previewVariantImage(event, ${index})" />
                                ${existingImgHtml}
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3"
                                        onclick="removeVariant(${index})">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `;
                        container.appendChild(row);
                    }

                    function removeVariant(index) {
                        document.getElementById(`variant-${index}`)?.remove();
                    }

                    function previewVariantImage(event, index) {
                        const file = event.target.files[0];
                        const preview = document.getElementById(`variantPreview-${index}`);
                        if (!file || !preview) return;

                        const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                        if (!allowed.includes(file.type)) {
                            event.target.value = '';
                            alert('Only JPG, PNG, and WEBP images are accepted.');
                            return;
                        }

                        const reader = new FileReader();
                        reader.onload = e => {
                            preview.src = e.target.result;
                            preview.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    }

                    // ── Main Images ────────────────────────────────────────
                    function previewImages(event) {
                        const preview = document.getElementById('imagePreview');
                        preview.innerHTML = '';

                        const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                        const files = Array.from(event.target.files).filter(f => allowed.includes(f.type)).slice(0, 5);

                        if (files.length < event.target.files.length) {
                            alert('Some files were skipped. Only JPG, PNG, and WEBP are accepted.');
                        }

                        files.forEach(file => {
                            const reader = new FileReader();
                            reader.onload = e => {
                                const img = document.createElement('img');
                                img.src = e.target.result;
                                img.style = 'width:80px;height:80px;object-fit:cover;border-radius:8px;border:2px solid #dee2e6;';
                                preview.appendChild(img);
                            };
                            reader.readAsDataURL(file);
                        });
                    }
                </script>
            }